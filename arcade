function flappy() {
  let yf = 560, vy = 0;
  let P = [0, 1, 2].map(i => ({ x: 64 + i * 44, g: rnd(16, 74), p: 0 }));
  let s = 0, go = 0, t = 0;
  let swingAng = -0.9;   // ketmon burchagi (dam olish holati — yuqoriga)
  let pn = phaseOf();    // joriy fazaning nomi

  const stars = [...Array(26)].map((_, i) => ({
    x: (i * 19 + 7) % 64, y: (i * 13 + 5) % 72,
    r: 0.25 + (i % 3) * 0.18, ph: i
  }));
  const clouds = [
    { x: 8, y: 18, s: 1.0, sp: 0.05 },
    { x: 40, y: 34, s: 0.8, sp: 0.035 },
    { x: 70, y: 12, s: 1.2, sp: 0.06 },
    { x: 22, y: 56, s: 0.9, sp: 0.04 }
  ];
  const birds = [
    { x: 6, y: 26, ph: 0, sp: 0.2 },
    { x: 24, y: 40, ph: 2, sp: 0.16 },
    { x: 48, y: 20, ph: 4, sp: 0.23 },
    { x: 70, y: 48, ph: 1, sp: 0.18 }
  ];
  const trail = [];

  const cloud = (cx, cy, k, c1, c2) => {
    circ(cx, cy, 3 * k, c1);
    circ(cx + 3.4 * k, cy + 0.7 * k, 2.4 * k, c1);
    circ(cx - 3.4 * k, cy + 0.9 * k, 2.2 * k, c1);
    RR(cx - 5.4 * k, cy + 0.8 * k, 11 * k, 2.4 * k, c2, 1.2 * k);
  };

  const sun = (cx, cy, r, glow, core, rays) => {
    circ(cx, cy, r * 2.6, glow);
    if (rays) {
      x.strokeStyle = 'rgba(253, 224, 71, 0.75)';
      x.lineWidth = 0.55 * S;
      x.lineCap = 'round';
      for (let i = 0; i < 12; i++) {
        const an = i * Math.PI / 6 + t * 0.012;
        x.beginPath();
        x.moveTo((cx + Math.cos(an) * (r + 1.4)) * S, (cy + Math.sin(an) * (r + 1.4)) * S);
        x.lineTo((cx + Math.cos(an) * (r + 3.2)) * S, (cy + Math.sin(an) * (r + 3.2)) * S);
        x.stroke();
      }
    }
    GL(core, 5);
    circ(cx, cy, r, core);
    NG();
  };

  const bird = (bx, by, ph, col) => {
    const f = Math.sin(t * 0.3 + ph) * 1.3;
    x.strokeStyle = col;
    x.lineWidth = 0.5 * S;
    x.lineCap = 'round';
    x.lineJoin = 'round';
    x.beginPath();
    x.moveTo((bx - 2.2) * S, (by - f) * S);
    x.quadraticCurveTo((bx - 1) * S, (by + 0.3) * S, bx * S, by * S);
    x.quadraticCurveTo((bx + 1) * S, (by + 0.3) * S, (bx + 2.2) * S, (by - f) * S);
    x.stroke();
  };

  return {
    step() {
      t++;
      if (t % 100 === 0) pn = phaseOf();   // osmon vaqt o'tishi bilan yangilanadi

      // Faqat qo'lda: tugma yoki ekranga bosish
      const f = I.dn || (L && !pL) || (R_ && !pR);

      if (!go) {
        if (f) {
          go = 1;
          vy = -30;
          swingAng = 0.5;
          sfx.flap();
        }
        swingAng = -0.9 + (swingAng + 0.9) * 0.8;
        return;
      }

      if (f) {
        vy = -30;
        swingAng = 0.5;   // ketmon pastga silkitiladi
        sfx.flap();
        for (let i = 0; i < 3; i++) {
          trail.push({
            x: 6.5, y: yf / 10 + 5.5 + rnd(-1, 2),
            vx: -1.4 - Math.random(),
            vy: (Math.random() - 0.5) * 0.8,
            l: 10
          });
        }
      }

      // Ketmon sekin yuqoriga qaytadi
      swingAng = -0.9 + (swingAng + 0.9) * 0.8;

      vy = Math.min(30, vy + 2.8);
      yf += vy;
      if (yf < 0) { yf = 0; vy = 0; }
      const y = Math.floor(yf / 10);
      if (y > 120) return s;

      trail.forEach(pt => { pt.x += pt.vx; pt.y += pt.vy; pt.l--; });
      while (trail.length && trail[0].l <= 0) trail.shift();

      for (const q of P) {
        q.x--;
        if (q.x < -9) { q.x += 132; q.g = rnd(16, 74); q.p = 0; }
        if (!q.p && q.x + 8 < 10) { q.p = 1; s++; sfx.point(); }
        if (17.5 > q.x && 8.5 < q.x + 8 && (y < q.g || y + 7.5 > q.g + 36)) return s;
      }
    },
    draw() {
      const ph = SKY[pn];
      BG3(ph.a, ph.b, ph.c);

      /* --- Osmon: yulduz/oy, quyosh, bulutlar, qushlar --- */
      if (pn === 'night') {
        stars.forEach(st => {
          const al = 0.35 + Math.sin(t * 0.12 + st.ph) * 0.3;
          circ(st.x, st.y, st.r, `rgba(254, 249, 195, ${al})`);
        });
        GL('#fef08a', 2.5);
        circ(51, 16, 4.2, '#fef08a');
        NG();
        circ(52.8, 14.8, 3.7, '#0f1833');
      } else if (pn === 'morning') {
        sun(48, 20, 4.8, 'rgba(255, 244, 170, 0.35)', '#fde047', true);
      } else if (pn === 'day') {
        sun(46, 14, 4.4, 'rgba(255, 244, 170, 0.28)', '#fde047', true);
      } else {
        // Kun botishi: ufqdagi katta qizil-to'q sariq quyosh
        circ(32, 90, 26, 'rgba(255, 120, 70, 0.18)');
        circ(32, 90, 17, 'rgba(255, 150, 70, 0.25)');
        GL('#ff8a3d', 6);
        circ(32, 90, 10, '#ff7a33');
        NG();
        circ(32, 90, 7.5, '#ffb15c');
      }

      if (ph.clouds) {
        clouds.forEach(c => {
          const cx = (((c.x - t * c.sp) % 90) + 90) % 90 - 12;
          cloud(cx, c.y, c.s, ph.clouds[0], ph.clouds[1]);
        });
        birds.forEach(b => {
          const bx = ((b.x + t * b.sp) % 84) - 10;
          const by = b.y + Math.sin(t * 0.05 + b.ph) * 2;
          bird(bx, by, b.ph, ph.bird);
        });
      }

      /* --- Yer va tepaliklar --- */
      const sil = ph.hill;
      const rim = ph.rim;
      RR(0, 96, 64, 32, sil, 0);
      RR(4, 103, 2.4, 25, sil, 0.4);
      circ(5.2, 103, 1.5, rim);
      circ(5.2, 103.3, 1.3, sil);
      circ(15, 111.5, 6.8, rim);
      circ(15, 112, 6.5, sil);
      RR(8.5, 112, 13, 16, sil, 0);
      circ(35, 113.5, 5.4, rim);
      circ(35, 114, 5.1, sil);
      RR(29.8, 114, 10.4, 14, sil, 0);
      RR(47, 100, 2.6, 28, sil, 0.4);
      circ(48.3, 100, 1.6, rim);
      circ(48.3, 100.3, 1.4, sil);
      circ(57, 110.5, 6.2, rim);
      circ(57, 111, 5.9, sil);
      RR(51, 111, 12, 17, sil, 0);

      P.forEach(q => {
        RR(q.x, -2, 8, q.g + 2, '#0f5132', 0.8);
        RR(q.x + 1.2, -2, 1.6, q.g + 2, 'rgba(52, 211, 153, 0.22)', 0.4);
        RR(q.x - 1, q.g - 4.2, 10, 4.2, '#15803d', 1);
        RR(q.x - 0.5, q.g - 3.6, 9, 0.8, '#fbbf24', 0.3);
        RR(q.x, q.g + 36, 8, H - q.g - 36, '#0f5132', 0.8);
        RR(q.x + 1.2, q.g + 36, 1.6, H - q.g - 36, 'rgba(52, 211, 153, 0.22)', 0.4);
        RR(q.x - 1, q.g + 36, 10, 4.2, '#15803d', 1);
        RR(q.x - 0.5, q.g + 36.6, 9, 0.8, '#fbbf24', 0.3);
      });

      trail.forEach(pt => circ(pt.x, pt.y, pt.l * 0.12, 'rgba(226, 232, 240, 0.55)'));

      // KETMONDA UCHAYOTGAN OTAXON
      const y = yf / 10 + (go ? 0 : Math.sin(t * 0.15) * 1.2);
      const tilt = cl(vy * 0.012, -0.28, 0.35);

      x.save();
      x.translate(13 * S, (y + 4) * S);
      x.rotate(tilt);
      x.translate(-13 * S, -(y + 4) * S);

      // 1. Oyoqlar, etik va yo'l-yo'l milliy chopon
      RR(11.4, y + 5.8, 2.2, 2.1, '#1e293b', 0.6);
      RR(12.2, y + 7.2, 2.4, 1.1, '#0f172a', 0.5);
      PG([[10.2, y + 2.5], [14.2, y + 2.5], [14.8, y + 6.2], [9.6, y + 6.2]], 0, 0, '#1d4ed8');
      RR(11.0, y + 2.7, 0.6, 3.2, '#38bdf8', 0.2);
      RR(12.8, y + 2.7, 0.6, 3.2, '#38bdf8', 0.2);
      RR(10.1, y + 4.9, 4.3, 0.8, '#f59e0b', 0.3);

      // 2. Bosh, oq soqol va do'ppi
      circ(12.5, y + 1.4, 1.75, '#fed7aa');
      PG([[12.8, y + 2.0], [14.5, y + 2.3], [13.5, y + 4.4], [11.5, y + 4.1], [11.7, y + 2.3]], 0, 0, '#f8fafc');
      circ(13.3, y + 1.1, 0.32, '#0f172a');
      PG([[10.8, y + 0.3], [11.3, y - 1.2], [13.7, y - 1.2], [14.2, y + 0.3]], 0, 0, '#0f172a');
      RR(11.4, y - 0.4, 0.6, 0.4, '#ffffff', 0.1);
      RR(12.8, y - 0.4, 0.6, 0.4, '#ffffff', 0.1);

      // 3. Chap qo'l yuqoriga ko'tarilib do'ppini ushlab turadi
      PG([[10.5, y + 3.0], [9.4, y + 1.2], [10.9, y - 0.4], [11.5, y + 0.2], [10.4, y + 1.3], [11.3, y + 2.6]], 0, 0, '#2563eb');
      circ(11.1, y - 0.4, 0.72, '#fed7aa');

      // 4. O'ng qo'l — ketmonni ushlab turadi
      x.strokeStyle = '#1e40af';
      x.lineWidth = 1.3 * S;
      x.lineCap = 'round';
      x.beginPath();
      x.moveTo(11.5 * S, (y + 3.2) * S);
      x.lineTo(14.9 * S, (y + 5.3) * S);
      x.stroke();

      // 5. KETMON — qo'l atrofida aylanadi
      x.save();
      x.translate(14.9 * S, (y + 5.3) * S);
      x.rotate(swingAng);

      // Dasta
      x.fillStyle = '#b45309';
      x.beginPath();
      x.roundRect(-4 * S, -0.4 * S, 8 * S, 0.8 * S, 0.3 * S);
      x.fill();
      x.fillStyle = '#d97706';
      x.beginPath();
      x.roundRect(-3.7 * S, -0.3 * S, 7.4 * S, 0.3 * S, 0.15 * S);
      x.fill();

      // Tig'
      x.fillStyle = '#94a3b8';
      x.beginPath();
      x.moveTo(3.5 * S, -1.2 * S);
      x.lineTo(6.8 * S, -1.0 * S);
      x.lineTo(7.3 * S, 1.8 * S);
      x.lineTo(4 * S, 1.5 * S);
      x.closePath();
      x.fill();
      x.fillStyle = '#e2e8f0';
      x.beginPath();
      x.moveTo(6.1 * S, -1.0 * S);
      x.lineTo(6.8 * S, -1.0 * S);
      x.lineTo(7.3 * S, 1.8 * S);
      x.lineTo(6.5 * S, 1.6 * S);
      x.closePath();
      x.fill();

      x.restore();

      // 6. Qo'l (ketmon ustida)
      circ(14.9, y + 5.3, 0.75, '#fed7aa');

      x.restore();

      T('' + s, 32, 8, 13, ph.txt, 'center');
      if (!go) T('Ketmonda uchish uchun bosing', 32, 102, 4.4, ph.sub, 'center');
    }
  };
}

/* 6. POYGA */
function race() {
  let ln = 1, Q = [], s = 0, off = 0, ls = 0, t = 0;

  const car = (a, b, c1, c2, me) => {
    RR(a + 0.2, b + 1.8, 1.5, 2.7, '#090d16', 0.6);
    RR(a + 10.3, b + 1.8, 1.5, 2.7, '#090d16', 0.6);
    RR(a + 0.2, b + 7.2, 1.5, 2.7, '#090d16', 0.6);
    RR(a + 10.3, b + 7.2, 1.5, 2.7, '#090d16', 0.6);
    if (me) {
      PG([[2.4, 0], [0.6, -9], [4.6, -9], [3.8, 0]], a, b, 'rgba(125, 211, 252, 0.18)');
      PG([[8.2, 0], [7.4, -9], [11.4, -9], [9.6, 0]], a, b, 'rgba(125, 211, 252, 0.18)');
      GL('#38bdf8', 2.5);
    }
    PG([[3.4, 0], [8.6, 0], [10.6, 2.4], [10.8, 9.8], [9.6, 11.4], [2.4, 11.4], [1.2, 9.8], [1.4, 2.4]], a, b, c1);
    NG();
    PG([[4.2, 0.8], [7.8, 0.8], [8.8, 3.2], [3.2, 3.2]], a, b, c2);
    RR(a + 0.5, b + 3.4, 1, 0.8, c1, 0.3);
    RR(a + 10.5, b + 3.4, 1, 0.8, c1, 0.3);
    PG([[3.2, 3.3], [8.8, 3.3], [8.2, 5.6], [3.8, 5.6]], a, b, '#0f172a');
    PG([[3.7, 3.6], [6.2, 3.6], [5.7, 5.2], [4.1, 5.2]], a, b, 'rgba(255, 255, 255, 0.24)');
    PG([[3.8, 7.6], [8.2, 7.6], [8.6, 9.3], [3.4, 9.3]], a, b, '#0f172a');
    RR(a + 1.5, b + 10, 9, 1.2, c2, 0.5);
    RR(a + 2.2, b + 0.3, 1.8, 0.8, me ? '#e0f2fe' : '#fef08a', 0.4);
    RR(a + 8.0, b + 0.3, 1.8, 0.8, me ? '#e0f2fe' : '#fef08a', 0.4);
    RR(a + 2.3, b + 10.8, 2.0, 0.6, '#ef4444', 0.3);
    RR(a + 7.7, b + 10.8, 2.0, 0.6, '#ef4444', 0.3);
  };

  const trafficCols = [
    ['#f43f5e', '#be123c'], ['#f59e0b', '#b45309'],
    ['#a855f7', '#7e22ce'], ['#10b981', '#047857']
  ];

  return {
    step() {
      t++;
      const d = (L && !pL ? -1 : 0) || (R_ && !pR ? 1 : 0);
      if (d < 0 && ln > 0) { ln--; sfx.swish(); }
      if (d > 0 && ln < 2) { ln++; sfx.swish(); }

      const sp = Math.min(5, 2 + Math.floor(s / 8));
      if (t - ls > Math.max(8, 18 - s * 0.33)) {
        if (Q.length < 3) {
          const pal = trafficCols[rnd(0, trafficCols.length)];
          Q.push({ l: rnd(0, 3), y: -13, c1: pal[0], c2: pal[1] });
        }
        ls = t;
      }

      off = (off + sp) % 16;
      for (const o of Q) {
        o.y += sp;
        if (o.y >= H) { o.d = 1; s++; sfx.pass(); continue; }
        if (o.l === ln && o.y + 10.5 > 107 && o.y < 118) { noise(0.3, 2400, 150, 0.18); return s; }
      }
      Q = Q.filter(o => !o.d);
    },
    draw() {
      BGc('#061a14', '#0b2920');
      RR(7, 0, 50, H, '#161b29', 0);
      RR(12, 0, 40, H, '#1b2132', 0);
      RR(6.2, 0, 1.2, H, '#38bdf8', 0);
      RR(56.6, 0, 1.2, H, '#38bdf8', 0);
      for (let y = -16 + off; y < H; y += 16) {
        RR(6.2, y, 1.2, 6, '#f8fafc', 0);
        RR(56.6, y, 1.2, 6, '#f8fafc', 0);
        RR(23.6, y, 1, 8, 'rgba(248, 250, 252, 0.45)', 0.4);
        RR(39.6, y, 1, 8, 'rgba(248, 250, 252, 0.45)', 0.4);
      }
      Q.forEach(o => car(8 + o.l * 16 + 2, o.y, o.c1, o.c2, 0));
      car(8 + ln * 16 + 2, 107, '#2dd4bf', '#0f766e', 1);
      hud(s);
      T('x' + Math.min(5, 2 + Math.floor(s / 8)), 61, 2, 7.5, '#facc15', 'right');
    }
  };
}

/* 6 ta o'yin ro'yxati */
const defs = [
  ['Kosmos', '🚀', '#38bdf8', 'Dushman kemalarini uring', shooter, "Chap va o'ng bosh barmoqlar bilan boshqaring", ['L', 'R'], 't2', 'Chap ◀ • O\'ng ▶'],
  ['Tetris', '🧱', '#c084fc', "Qatorlarni to'ldiring", tetris, 'Chap qo\'l: ◀ ▶   •   O\'ng qo\'l: ▼ ⟳', ['L', 'R', 'D', 'T'], 't4', '◀ ▶ • ▼ ⟳'],
  ['Pong', '🏓', '#60a5fa', "To'pni tushirmang", pong, "Chap va o'ng bosh barmoqlar bilan boshqaring", ['L', 'R'], 't2', 'Chap ◀ • O\'ng ▶'],
  ["G'isht", '💥', '#fb7185', "G'ishtlarni sindiring", brk, "Chap va o'ng bosh barmoqlar bilan boshqaring", ['L', 'R'], 't2', 'Chap ◀ • O\'ng ▶'],
  ['Uchar ketmon', '👳‍♂️', '#facc15', "Ketmonda quvurlardan o'ting", flappy, "Bosing yoki ekranga tegining", ['J'], 't1', 'Sakrash ▲'],
  ['Poyga', '🏎️', '#34d399', "To'siqlardan qoching", race, "Chap va o'ng bosh barmoqlar bilan boshqaring", ['L', 'R'], 't2', 'Chap ◀ • O\'ng ▶']
];

let best = [0, 0, 0, 0, 0, 0];
try {
  const saved = JSON.parse(localStorage.getItem('arc'));
  if (Array.isArray(saved) && saved.length === 6) best = saved;
} catch (e) {}

const save = () => {
  try { localStorage.setItem('arc', JSON.stringify(best)); } catch (e) {}
};

$('grid').innerHTML = defs.map((d, i) => `
  <button class="card" data-i="${i}" style="--c1:${d[2]}">
    <em></em>
    <i>${d[1]}</i>
    <b>${d[0]}</b>
    <small>${d[3]}</small>
    <span>${d[8]}</span>
  </button>
`).join('');

const badges = document.querySelectorAll('.card em');
const rb = () => {
  badges.forEach((e, i) => (e.textContent = '★ ' + best[i]));
  $('tot').textContent = '★ ' + best.reduce((a, b) => a + b, 0);
};
rb();

document.querySelectorAll('.card').forEach(c => {
  c.onclick = () => start(+c.dataset.i);
});

let st = 'menu', g = 0, G = null;

function fitCv() {
  if ($('game').hidden) return;
  const a = $('stage');
  const w = Math.max(120, a.clientWidth - 24);
  const h = Math.max(240, a.clientHeight - 14);
  const ch = Math.min(h, w * 2);
  const cw = ch / 2;
  const d = window.devicePixelRatio || 1;
  cv.style.width = Math.floor(cw) + 'px';
  cv.style.height = Math.floor(ch) + 'px';
  cv.width = Math.round(cw * d);
  cv.height = Math.round(ch * d);
  S = cv.width / W;
}
addEventListener('resize', fitCv);

const ov = (t, s, l1, f1, l2, f2) => {
  $('ot').textContent = t;
  $('os').textContent = s;
  $('b1').textContent = l1;
  $('b1').onclick = f1;
  $('b2').textContent = l2;
  $('b2').onclick = f2;
  $('ov').hidden = 0;
};

const toMenu = () => {
  st = 'menu';
  sfx.click();
  $('ov').hidden = 1;
  $('game').hidden = 1;
  $('menu').hidden = 0;
  rb();
};

function start(i) {
  g = i;
  G = defs[i][4]();
  Lh = Rh = Ll = Rl = Dh = 0;
  I.tap = I.dn = 0;
  $('menu').hidden = 1;
  $('game').hidden = 0;
  $('ov').hidden = 1;

  const ks = defs[i][6];
  const groups = ks.length === 4 ? [['L', 'R'], ['D', 'T']] : ks.length === 1 ? [ks] : [[ks[0]], [ks[1]]];
  mkPad(groups, 'pad ' + defs[i][7], defs[i][5]);

  fitCv();
  requestAnimationFrame(fitCv);
  st = 'play';
  sfx.start();
}

function pause() {
  if (st !== 'play') return;
  st = 'pause';
  Lh = Rh = Dh = 0;
  sfx.click();
  ov('Pauza', '', 'Davom etish', () => {
    sfx.click();
    $('ov').hidden = 1;
    st = 'play';
  }, 'Menyu', toMenu);
}

function end(r) {
  st = 'over';
  const nb = r > best[g];
  if (nb) { best[g] = r; save(); }
  sfx.over();
  if (nb) [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => bell(f, 0.3, 0.08, 0.6 + i * 0.09));
  ov(
    "O'yin tugadi",
    'Ball: ' + r + '\n' + (nb ? 'Yangi rekord! 🎉' : 'Rekord: ' + best[g]),
    "Qayta o'ynash",
    () => start(g),
    'Menyu',
    toMenu
  );
}

$('pz').onclick = pause;
document.addEventListener('visibilitychange', () => {
  if (document.hidden) pause();
});

setInterval(() => {
  L = Lh || Ll;
  R_ = Rh || Rl;
  if (st === 'play' && G) {
    const r = G.step();
    G.draw();
    if (r !== undefined) end(r);
  }
  pL = L;
  pR = R_;
  Ll = Rl = 0;
  I.tap = I.dn = 0;
}, 45);
</script>
