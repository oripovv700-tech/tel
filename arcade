<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>ARCADE</title>
<style>
  :root {
    --bg-1: #090b14;
    --bg-2: #121629;
    --tx: #f3f5fc;
    --sub: #8f96b2;
    --glass: rgba(255, 255, 255, 0.045);
    --glass-card: rgba(255, 255, 255, 0.055);
    --glass-strong: rgba(18, 22, 41, 0.84);
    --border: rgba(255, 255, 255, 0.1);
    --border-top: rgba(255, 255, 255, 0.22);
    color-scheme: dark;
    box-sizing: border-box;
  }

  *, *::before, *::after { box-sizing: inherit; }

  html, body {
    margin: 0; padding: 0; width: 100%; height: 100dvh;
    background: linear-gradient(165deg, var(--bg-1) 0%, var(--bg-2) 100%);
    color: var(--tx);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  [hidden] { display: none !important; }

  #menu {
    height: 100dvh; max-width: 480px; margin: 0 auto;
    padding: calc(16px + env(safe-area-inset-top, 0px)) 16px calc(22px + env(safe-area-inset-bottom, 0px));
    display: flex; flex-direction: column; overflow-y: auto; scrollbar-width: none;
  }
  #menu::-webkit-scrollbar { display: none; }

  .hdr {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; padding: 14px 18px; margin-bottom: 14px;
    border-radius: 22px;
    background: var(--glass);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border); border-top-color: var(--border-top);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  h1 { margin: 0; font-size: 25px; font-weight: 800; letter-spacing: 1.5px; color: #ffffff; }
  .sub { margin: 3px 0 0; color: var(--sub); font-size: 12.5px; line-height: 1.3; }

  .tot {
    padding: 7px 13px; border-radius: 99px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-top);
    font-size: 13px; font-weight: 700; color: #fde047; white-space: nowrap;
  }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 11px; flex: 1; }

  .card {
    position: relative; min-height: 148px; border-radius: 22px; padding: 14px;
    text-align: left; color: var(--tx);
    background: linear-gradient(160deg, var(--glass-card) 0%, rgba(255, 255, 255, 0.018) 100%);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border); border-top-color: var(--border-top);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    display: flex; flex-direction: column; justify-content: flex-end;
    font: inherit; cursor: pointer;
    transition: transform 0.14s ease, background 0.14s ease, border-color 0.14s ease;
  }

  .card:active {
    transform: scale(0.97);
    background: rgba(255, 255, 255, 0.1);
    border-color: color-mix(in srgb, var(--c1) 45%, rgba(255, 255, 255, 0.2));
  }

  .card i {
    position: absolute; top: 12px; left: 12px;
    width: 42px; height: 42px; border-radius: 13px;
    display: grid; place-items: center;
    font-style: normal; font-size: 21px;
    background: color-mix(in srgb, var(--c1) 18%, rgba(255, 255, 255, 0.04));
    border: 1px solid color-mix(in srgb, var(--c1) 38%, rgba(255, 255, 255, 0.12));
    box-shadow: 0 0 16px color-mix(in srgb, var(--c1) 24%, transparent);
  }

  .card em {
    position: absolute; top: 13px; right: 12px;
    font-style: normal; font-size: 11px; font-weight: 700; color: #e2e8f0;
    background: rgba(9, 11, 20, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 99px; padding: 3px 9px;
  }

  .card b { font-size: 17.5px; font-weight: 700; letter-spacing: 0.2px; color: #ffffff; }
  .card small { font-size: 11.5px; line-height: 1.32; color: var(--sub); margin-top: 3px; }
  .card span {
    display: block; font-size: 10.5px;
    color: color-mix(in srgb, var(--c1) 75%, #cbd5e1);
    margin-top: 4px; font-weight: 500;
  }

  #game {
    height: 100dvh; width: 100%; max-width: 480px; margin: 0 auto;
    padding-top: env(safe-area-inset-top, 0px);
    display: flex; flex-direction: column; justify-content: space-between;
  }

  #stage {
    flex: 1; min-height: 0; width: 100%;
    display: flex; align-items: center; justify-content: center;
    position: relative; padding: 10px 14px 6px;
  }

  canvas {
    display: block; border-radius: 20px;
    border: 1px solid var(--border-top);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.55);
    touch-action: none; -webkit-touch-callout: none;
  }

  #pz {
    position: absolute; top: 14px; right: 18px;
    width: 40px; height: 40px; border-radius: 13px;
    border: 1px solid var(--border); border-top-color: var(--border-top);
    background: rgba(14, 18, 34, 0.68);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    color: #f1f5f9; font-size: 13px;
    display: grid; place-items: center;
    cursor: pointer; z-index: 2;
  }
  #pz:active { transform: scale(0.92); }

  #padWrap {
    flex: 0 0 auto; width: 100%;
    padding: 7px 18px calc(14px + env(safe-area-inset-bottom, 0px));
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    border-radius: 26px 26px 0 0;
  }

  .hint {
    text-align: center; font-size: 11px; font-weight: 500;
    color: var(--sub); margin-bottom: 6px; letter-spacing: 0.2px;
  }

  #pad {
    height: clamp(90px, 15.5dvh, 124px);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  #pad.t1 { justify-content: center; }
  #pad .g { display: flex; align-items: center; gap: 12px; }

  .pb {
    width: clamp(66px, 17vw, 76px); height: clamp(66px, 17vw, 76px);
    border-radius: 50%; padding: 0;
    display: grid; place-items: center;
    border: 1px solid var(--border); border-top-color: var(--border-top);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0.025) 100%);
    color: #f8fafc;
    font: 700 22px -apple-system, BlinkMacSystemFont, sans-serif;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    touch-action: none; -webkit-touch-callout: none; cursor: pointer;
    transition: transform 0.07s ease, background 0.07s ease, border-color 0.07s ease, box-shadow 0.07s ease;
  }
  .pb.big { width: clamp(84px, 21.5vw, 96px); height: clamp(84px, 21.5vw, 96px); font-size: 28px; }
  .pb.on {
    transform: scale(0.91);
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 22px rgba(148, 163, 184, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  #ov {
    position: fixed; inset: 0;
    background: rgba(6, 8, 16, 0.68);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    display: flex; align-items: center; justify-content: center;
    z-index: 10; padding: 20px;
  }

  .pop {
    width: min(86vw, 320px);
    background: var(--glass-strong);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border); border-top-color: var(--border-top);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.65);
    color: var(--tx); border-radius: 26px;
    padding: 24px 20px 20px; text-align: center;
  }
  .pop h2 { margin: 0 0 6px; font-size: 24px; font-weight: 800; color: #ffffff; }
  .pop p { margin: 0 0 18px; color: #cbd5e1; font-size: 15px; line-height: 1.5; white-space: pre-line; }
  .pop button {
    display: block; width: 100%; height: 48px;
    border-radius: 15px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.06);
    color: #f1f5f9; font: 600 15px inherit; margin-top: 9px; cursor: pointer;
  }
  .pop button:active { transform: scale(0.98); }
  .pop button.pri { border: 0; background: #f1f5f9; color: #090b14; font-weight: 700; }
</style>
</head>
<body>

<section id="menu">
  <div class="hdr">
    <div>
      <h1>ARCADE</h1>
      <p class="sub">O'yinni tanlang va tugmalar bilan o'ynang</p>
    </div>
    <div class="tot" id="tot">★ 0</div>
  </div>
  <div class="grid" id="grid"></div>
</section>

<section id="game" hidden>
  <div id="stage">
    <canvas id="c"></canvas>
    <button id="pz" aria-label="Pauza">❚❚</button>
  </div>
  <div id="padWrap">
    <div class="hint" id="hint"></div>
    <div id="pad"></div>
  </div>
</section>

<div id="ov" hidden>
  <div class="pop">
    <h2 id="ot"></h2>
    <p id="os"></p>
    <button class="pri" id="b1"></button>
    <button id="b2"></button>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);
const cv = $('c');
const x = cv.getContext('2d');
const W = 64, H = 128;
let S = 5;

if (!x.roundRect) {
  x.roundRect = function(a, b, w, h) { this.rect(a, b, w, h); };
}

const RR = (a, b, w, h, c, r = 0.6) => {
  x.fillStyle = c;
  x.beginPath();
  x.roundRect(a * S, b * S, w * S, h * S, r * S);
  x.fill();
};

const circ = (a, b, r, c) => {
  x.fillStyle = c;
  x.beginPath();
  x.arc(a * S, b * S, r * S, 0, Math.PI * 2);
  x.fill();
};

const PG = (pts, ox, oy, col) => {
  x.fillStyle = col;
  x.beginPath();
  pts.forEach((q, i) => x[i ? 'lineTo' : 'moveTo']((ox + q[0]) * S, (oy + q[1]) * S));
  x.closePath();
  x.fill();
};

const GL = (c, b) => { x.shadowColor = c; x.shadowBlur = b * S; };
const NG = () => { x.shadowBlur = 0; };

const T = (s, a, b, z, c, al) => {
  x.font = '700 ' + (z * S) + 'px -apple-system, BlinkMacSystemFont, sans-serif';
  x.textBaseline = 'top';
  x.textAlign = al || 'left';
  x.fillStyle = c || '#ffffff';
  x.fillText(s, a * S, b * S);
};

const BGc = (c1, c2) => {
  const g = x.createLinearGradient(0, 0, 0, H * S);
  g.addColorStop(0, c1);
  g.addColorStop(1, c2);
  x.fillStyle = g;
  x.fillRect(0, 0, W * S, H * S);
};

const BG3 = (c1, c2, c3) => {
  const g = x.createLinearGradient(0, 0, 0, H * S);
  g.addColorStop(0, c1);
  g.addColorStop(0.55, c2);
  g.addColorStop(1, c3);
  x.fillStyle = g;
  x.fillRect(0, 0, W * S, H * S);
};

const hud = (s, lv) => {
  T('' + s, 3, 2, 7.5);
  if (lv != null) T('♥'.repeat(lv), 61, 2, 7.5, '#fb7185', 'right');
};

const rnd = (a, b) => a + Math.floor(Math.random() * (b - a));
const cl = (v, a, b) => Math.max(a, Math.min(b, v));
const sg = () => (Math.random() < 0.5 ? 1 : -1);
const PC = ['#38bdf8', '#facc15', '#c084fc', '#4ade80', '#fb7185', '#60a5fa', '#fb923c'];

/* ============ OVOZ TIZIMI (Web Audio API) ============ */
let ac, mst, nbuf;

const AX = () => {
  try {
    if (!ac) {
      ac = new (window.AudioContext || window.webkitAudioContext)();
      const cp = ac.createDynamicsCompressor();
      mst = ac.createGain();
      mst.gain.value = 0.9;
      mst.connect(cp);
      cp.connect(ac.destination);
      nbuf = ac.createBuffer(1, ac.sampleRate, ac.sampleRate);
      const d = nbuf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
    }
    if (ac.state === 'suspended') ac.resume();
    return ac;
  } catch (e) { return null; }
};

/* Yumshoq tovush: tez kirish, silliq so'nish, ixtiyoriy chastota sirpanishi */
const tone = (f, d, o = {}) => {
  const a = AX();
  if (!a) return;
  const t0 = a.currentTime + (o.at || 0);
  const osc = a.createOscillator();
  const g = a.createGain();
  osc.type = o.type || 'sine';
  osc.frequency.setValueAtTime(f, t0);
  if (o.to) osc.frequency.exponentialRampToValueAtTime(o.to, t0 + d);
  g.gain.setValueAtTime(0.0001, t0);
  g.gain.exponentialRampToValueAtTime(o.vol || 0.1, t0 + (o.atk || 0.008));
  g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
  osc.connect(g);
  g.connect(mst);
  osc.start(t0);
  osc.stop(t0 + d + 0.03);
};

/* Shovqin (portlash, shamol, zarba uchun) */
const noise = (d, f0, f1, vol, at = 0) => {
  const a = AX();
  if (!a) return;
  const t0 = a.currentTime + at;
  const src = a.createBufferSource();
  src.buffer = nbuf;
  const fl = a.createBiquadFilter();
  fl.type = 'lowpass';
  fl.frequency.setValueAtTime(f0, t0);
  fl.frequency.exponentialRampToValueAtTime(f1, t0 + d);
  const g = a.createGain();
  g.gain.setValueAtTime(vol, t0);
  g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
  src.connect(fl);
  fl.connect(g);
  g.connect(mst);
  src.start(t0);
  src.stop(t0 + d + 0.02);
};

/* Qo'ng'iroqcha: asosiy chastota + yumshoq overton */
const bell = (f, d = 0.25, v = 0.1, at = 0) => {
  tone(f, d, { vol: v, at });
  tone(f * 2, d * 0.6, { vol: v * 0.3, at });
};

const PENTA = [523.25, 587.33, 659.25, 783.99, 880, 1046.5];

const sfx = {
  start() { [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => bell(f, 0.28, 0.09, i * 0.07)); },
  over() { [392, 329.63, 261.63, 196].forEach((f, i) => tone(f, 0.3, { type: 'triangle', vol: 0.1, at: i * 0.13 })); },
  click() { tone(660, 0.05, { type: 'triangle', vol: 0.05 }); },

  /* Kosmos */
  laser() { tone(1400, 0.11, { type: 'triangle', to: 380, vol: 0.045 }); },
  hit() { tone(300, 0.07, { type: 'square', to: 180, vol: 0.03 }); noise(0.05, 3000, 800, 0.05); },
  boom() { noise(0.32, 2600, 150, 0.16); tone(170, 0.26, { to: 45, vol: 0.2 }); },
  hurt() { tone(260, 0.28, { type: 'sawtooth', to: 70, vol: 0.07 }); noise(0.18, 1200, 120, 0.08); },

  /* Tetris */
  move() { tone(520, 0.04, { type: 'triangle', vol: 0.05 }); },
  rot() { tone(660, 0.07, { type: 'triangle', to: 990, vol: 0.06 }); },
  lock() { tone(150, 0.09, { to: 80, vol: 0.14 }); noise(0.04, 900, 300, 0.05); },
  clear(n) { for (let i = 0; i < n + 2 && i < PENTA.length; i++) bell(PENTA[i], 0.3, 0.09, i * 0.06); },

  /* Pong va G'isht */
  wall() { tone(330, 0.05, { type: 'triangle', vol: 0.06 }); },
  paddle() { tone(220, 0.1, { to: 150, vol: 0.16 }); tone(880, 0.06, { type: 'triangle', vol: 0.05 }); },
  brick(r) { bell(PENTA[5 - cl(r, 0, 5)], 0.22, 0.08); noise(0.03, 4000, 1500, 0.03); },

  /* Ketmonchi */
  flap() { tone(420, 0.12, { to: 760, vol: 0.07 }); noise(0.08, 2500, 700, 0.03); },
  point() { bell(988, 0.16, 0.08); bell(1318.5, 0.24, 0.08, 0.07); },

  /* Poyga */
  swish() { noise(0.12, 3500, 500, 0.07); tone(500, 0.07, { type: 'triangle', to: 700, vol: 0.03 }); },
  pass() { bell(1174.7, 0.12, 0.045); }
};

addEventListener('pointerdown', AX, { once: true });
/* ======================================================= */

/* Boshqaruv holatlari */
let Lh = 0, Rh = 0, Ll = 0, Rl = 0, Dh = 0, L = 0, R_ = 0, pL = 0, pR = 0;
const I = { tap: 0, dn: 0 };

const press = (k, v) => {
  if (k === 'L') { Lh = v; if (v) Ll = 1; }
  else if (k === 'R') { Rh = v; if (v) Rl = 1; }
  else if (k === 'D') { Dh = v; }
  else if (v) {
    if (k === 'T') I.tap = 1;
    else I.dn = 1;
  }
};

const KC = { L: '◀', R: '▶', T: '⟳', D: '▼', J: '▲' };

function mkPad(gr, cls, hintTxt) {
  const p = $('pad');
  p.className = cls;
  $('hint').textContent = hintTxt;
  p.innerHTML = gr.map(g =>
    '<div class="g">' +
    g.map(k => `<button class="pb${k === 'J' ? ' big' : ''}" data-k="${k}">${KC[k]}</button>`).join('') +
    '</div>'
  ).join('');

  p.querySelectorAll('button').forEach(b => {
    const k = b.dataset.k;
    b.addEventListener('pointerdown', e => {
      e.preventDefault();
      try { b.setPointerCapture(e.pointerId); } catch (err) {}
      press(k, 1);
      b.classList.add('on');
    });
    ['pointerup', 'pointercancel', 'lostpointercapture'].forEach(v =>
      b.addEventListener(v, () => {
        press(k, 0);
        b.classList.remove('on');
      })
    );
  });
}

cv.addEventListener('pointerdown', e => { e.preventDefault(); I.dn = 1; });

addEventListener('keydown', e => {
  const k = e.key;
  if (k === 'ArrowLeft' || k === 'a' || k === 'A') { Lh = 1; Ll = 1; }
  else if (k === 'ArrowRight' || k === 'd' || k === 'D') { Rh = 1; Rl = 1; }
  else if (k === 'ArrowUp' || k === 'w' || k === 'W' || k === ' ') { I.tap = 1; I.dn = 1; }
  else if (k === 'ArrowDown' || k === 's' || k === 'S') { Dh = 1; }
  else if (k === 'Escape' || k === 'p' || k === 'P') pause();
});

addEventListener('keyup', e => {
  const k = e.key;
  if (k === 'ArrowLeft' || k === 'a' || k === 'A') Lh = 0;
  if (k === 'ArrowRight' || k === 'd' || k === 'D') Rh = 0;
  if (k === 'ArrowDown' || k === 's' || k === 'S') Dh = 0;
});

const ctl = (p, w) => cl(p + (R_ ? 3 : 0) - (L ? 3 : 0), 0, W - w);

/* 1. KOSMOS */
const ENM_SPEC = {
  1: { w: 7.5, h: 7.5, c: '#38bdf8', sec: '#0284c7' },
  2: { w: 11.5, h: 9.0, c: '#fbbf24', sec: '#d97706' },
  3: { w: 15.5, h: 11.0, c: '#fb7185', sec: '#e11d48' }
};

function shooter() {
  let p = 26, b = [], e = [], s = 0, lv = 3, t = 0, ls = 0, lp = 0;
  const stars = [...Array(36)].map((_, i) => ({
    x: rnd(0, 64), y: rnd(0, 128),
    s: 0.6 + (i % 3) * 0.55,
    a: 0.25 + (i % 4) * 0.18, ph: i
  }));

  return {
    step() {
      t++;
      p = ctl(p, 12);
      if (t - ls > 6 && b.length < 6) { b.push({ x: p + 5.4, y: 111 }); ls = t; sfx.laser(); }
      if (t - lp > Math.max(15, 38 - s * 0.48)) {
        if (e.length < 5) {
          const hp = rnd(1, 4);
          const sp = ENM_SPEC[hp];
          e.push({ x: rnd(1, W - sp.w - 1), y: -sp.h - 1, w: sp.w, h_px: sp.h, h: hp, mx: hp, f: 0 });
        }
        lp = t;
      }
      b.forEach(q => (q.y -= 4.2));
      b = b.filter(q => q.y >= 0);

      const k = Math.max(1, 2 - Math.floor(s / 15));
      for (const m of e) {
        if (t % k === 0) m.y++;
        const i = b.findIndex(q => q.x + 1.3 >= m.x && q.x <= m.x + m.w && q.y >= m.y && q.y <= m.y + m.h_px);
        if (i >= 0) {
          b.splice(i, 1);
          m.h--; m.f = 3;
          if (m.h <= 0) { m.d = 1; s += m.mx; sfx.boom(); }
          else sfx.hit();
          continue;
        }
        if (m.y + m.h_px >= 115 && m.x + m.w >= p + 1 && m.x <= p + 11) {
          m.d = 1; lv--; sfx.hurt(); continue;
        }
        if (m.y >= H) { m.d = 1; lv--; sfx.hurt(); }
      }
      e = e.filter(m => !m.d);
      if (lv <= 0) return s;
    },
    draw() {
      BGc('#050814', '#10172e');
      circ(18, 34, 18, 'rgba(56, 189, 248, 0.04)');
      circ(48, 84, 22, 'rgba(168, 85, 247, 0.045)');
      stars.forEach(a => {
        a.y = (a.y + a.s * 0.24) % H;
        const tw = a.a * (0.75 + 0.25 * Math.sin(t * 0.15 + a.ph));
        circ(a.x, a.y, 0.26 * a.s, `rgba(255, 255, 255, ${tw})`);
      });
      hud(s, lv);

      const fl = t % 4 < 2 ? 2.8 : 4.6;
      GL('#38bdf8', 2.5);
