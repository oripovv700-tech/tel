/* 2. TETRIS */
function tetris() {
  const P = [0x0F00, 0x0660, 0x4E00, 0x6C00, 0xC600, 0x8E00, 0x2E00];
  const B = Array.from({ length: 20 }, () => Array(10).fill(0));
  let p = rnd(0, 7), n = rnd(0, 7), rt = 0, px = 3, py = 0, s = 0, ln = 0;
  let lf = performance.now(), hs = 0, lm = 0;

  const cell = (piece, r, a, b) => {
    for (let i = 0; i < r; i++) { const tmp = a; a = 3 - b; b = tmp; }
    return (P[piece] & (0x8000 >> (a * 4 + b))) !== 0;
  };

  const fit = (piece, r, X, Y) => {
    for (let a = 0; a < 4; a++) for (let b = 0; b < 4; b++) {
      if (!cell(piece, r, a, b)) continue;
      const u = X + b, v = Y + a;
      if (u < 0 || u >= 10 || v >= 20) return 0;
      if (v >= 0 && B[v][u]) return 0;
    }
    return 1;
  };

  const mv = d => { if (fit(p, rt, px + d, py)) { px += d; sfx.move(); } };
  const rot = () => {
    const r = (rt + 1) & 3;
    for (const k of [0, -1, 1, -2, 2]) {
      if (fit(p, r, px + k, py)) { rt = r; px += k; sfx.rot(); return; }
    }
  };

  const blk = (a, b, c, z = 4.4) => {
    RR(a, b, z, z, c, 1);
    RR(a + 0.45, b + 0.38, z - 0.9, 1.25, 'rgba(255,255,255,0.42)', 0.55);
    RR(a + 0.45, b + z - 1.1, z - 0.9, 0.7, 'rgba(0,0,0,0.22)', 0.4);
  };

  return {
    step() {
      const now = performance.now();
      if (L !== R_) {
        const d = L ? -1 : 1;
        if ((L && !pL) || (R_ && !pR)) { mv(d); hs = now; lm = now; }
        else if (now - hs > 240 && now - lm > 75) { mv(d); lm = now; }
      }
      if (I.tap || (L && R_ && (!pL || !pR))) rot();

      const iv = Dh ? 38 : Math.max(115, 580 - Math.floor(ln / 5) * 48);
      if (now - lf >= iv) {
        lf = now;
        if (fit(p, rt, px, py + 1)) py++;
        else {
          for (let a = 0; a < 4; a++) for (let b = 0; b < 4; b++) {
            if (cell(p, rt, a, b)) {
              const v = py + a, u = px + b;
              if (v >= 0 && v < 20 && u >= 0 && u < 10) B[v][u] = p + 1;
            }
          }
          s++;
          let c = 0;
          for (let r = 19; r >= 0; r--) {
            if (B[r].every(v => v)) { B.splice(r, 1); B.unshift(Array(10).fill(0)); c++; r++; }
          }
          if (c) { ln += c; s += [0, 10, 30, 60, 100][c]; sfx.clear(c); }
          else sfx.lock();
          p = n; n = rnd(0, 7); rt = 0; px = 3; py = 0;
          if (!fit(p, rt, px, py)) return s;
        }
      }
    },
    draw() {
      BGc('#090d1c', '#151b36');
      RR(5.5, 0.5, 53, 100.5, 'rgba(255,255,255,0.06)', 1.5);
      RR(6.3, 1.1, 51.4, 99.2, 'rgba(9,13,28,0.65)', 1.2);
      for (let r = 0; r < 20; r++) for (let c = 0; c < 10; c++)
        if (B[r][c]) blk(7 + c * 5, r * 5 + 0.6, PC[B[r][c] - 1]);

      let gy = py;
      while (fit(p, rt, px, gy + 1)) gy++;
      for (let a = 0; a < 4; a++) for (let b = 0; b < 4; b++) {
        if (!cell(p, rt, a, b)) continue;
        if (gy + a >= 0) RR(7 + (px + b) * 5, (gy + a) * 5 + 0.6, 4.4, 4.4, 'rgba(255,255,255,0.14)', 1);
        if (py + a >= 0) blk(7 + (px + b) * 5, (py + a) * 5 + 0.6, PC[p]);
      }
      RR(39.5, 103, 21, 22, 'rgba(255,255,255,0.05)', 1.4);
      for (let a = 0; a < 4; a++) for (let b = 0; b < 4; b++)
        if (cell(n, 0, a, b)) blk(42 + b * 4, 107.5 + a * 4, PC[n], 3.4);

      T('Ball', 3.5, 103.5, 4.8, '#94a3b8');
      T('' + s, 3.5, 109.5, 9.5, '#ffffff');
      T('Qator ' + ln, 3.5, 120.5, 4.8, '#94a3b8');
    }
  };
}

/* 3. PONG */
function pong() {
  let p = 25, X = 30, Y = 58, vx = sg(), vy = 2, s = 0;
  return {
    step() {
      p = ctl(p, 14);
      X += vx; Y += vy;
      if (X <= 0) { X = 0; vx = Math.abs(vx); sfx.wall(); }
      if (X >= 61) { X = 61; vx = -Math.abs(vx); sfx.wall(); }
      if (Y <= 12) { Y = 12; vy = Math.abs(vy); sfx.wall(); }
      if (vy > 0 && Y + 3 >= 120 && Y <= 122.5 && X + 3 >= p && X <= p + 14) {
        Y = 117; s++;
        vy = -Math.min(4.2, 2 + Math.floor(s / 6) * 0.45);
        vx = cl(Math.trunc((X + 1.5 - (p + 7)) / 2), -3, 3);
        if (!vx) vx = sg();
        sfx.paddle();
        if (s % 5 === 0) bell(1318.5, 0.2, 0.06, 0.05);
      }
      if (Y >= H) return s;
    },
    draw() {
      BGc('#070d1f', '#121d42');
      hud(s);
      for (let y = 14; y < H; y += 8) RR(31, y, 2, 4, 'rgba(255,255,255,0.12)', 1);
      GL('#22d3ee', 3);
      RR(p, 120, 14, 3.5, '#22d3ee', 1.7);
      NG();
      RR(p + 1, 120.5, 12, 1, 'rgba(255,255,255,0.65)', 0.5);
      GL('#ffffff', 3);
      circ(X + 1.5, Y + 1.5, 2, '#ffffff');
      NG();
    }
  };
}

/* 4. G'ISHT */
function brk() {
  let br = Array(5).fill(63), p = 24, lv = 3, s = 0, X, Y, vx, vy, w = 0;
  const rc = ['#fb7185', '#fb923c', '#facc15', '#4ade80', '#38bdf8'];
  const serve = () => { X = p + 7; Y = 100; vx = sg(); vy = -3; w = 18; };
  serve();

  return {
    step() {
      p = ctl(p, 16);
      if (w > 0) { w--; return; }
      X += vx; Y += vy;
      if (X <= 0) { X = 0; vx = Math.abs(vx); sfx.wall(); }
      if (X >= 61) { X = 61; vx = -Math.abs(vx); sfx.wall(); }
      if (Y <= 12) { Y = 12; vy = Math.abs(vy); sfx.wall(); }

      const cx = X + 1.5, cy = Y + 1.5;
      if (cy >= 16 && cy < 46 && cx >= 2) {
        const r = Math.floor((cy - 16) / 6);
        const c = Math.floor((cx - 2) / 10);
        if (r >= 0 && r < 5 && c >= 0 && c < 6 && ((br[r] >> c) & 1)) {
          br[r] &= ~(1 << c);
          vy = -vy; s++;
          sfx.brick(r);
          if (!br.some(v => v)) { br.fill(63); serve(); sfx.clear(4); return; }
        }
      }
      if (vy > 0 && Y + 3 >= 120 && Y <= 122.5 && X + 3 >= p && X <= p + 16) {
        Y = 117; vy = -3;
        vx = cl(Math.trunc((X + 1.5 - (p + 8)) / 3), -2, 2);
        if (!vx) vx = sg();
        sfx.paddle();
      }
      if (Y >= H) {
        lv--; sfx.hurt();
        if (lv <= 0) return s;
        serve();
      }
    },
    draw() {
      BGc('#0b0c22', '#19143b');
      hud(s, lv);
      for (let r = 0; r < 5; r++) for (let c = 0; c < 6; c++)
        if ((br[r] >> c) & 1) {
          RR(2 + c * 10, 16 + r * 6, 9, 5, rc[r], 1.2);
          RR(2.6 + c * 10, 16.4 + r * 6, 7.8, 1.3, 'rgba(255,255,255,0.45)', 0.6);
        }
      GL('#38bdf8', 3);
      RR(p, 120, 16, 3.5, '#38bdf8', 1.7);
      NG();
      RR(p + 1, 120.5, 14, 1, 'rgba(255,255,255,0.65)', 0.5);
      GL('#ffffff', 3);
      circ(X + 1.5, Y + 1.5, 2, '#ffffff');
      NG();
    }
  };
}

/* 5. KETMONCHI — faqat qo'lda boshqariladi, osmon Toshkent vaqtiga qarab o'zgaradi */

/* O'zbekiston (Asia/Tashkent) vaqtiga ko'ra kun fazasi */
function phaseOf() {
  let h;
  try {
    const parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Tashkent', hour: 'numeric', minute: 'numeric', hour12: false
    }).formatToParts(new Date());
    const hh = parseInt(parts.find(q => q.type === 'hour').value, 10) % 24;
    const mm = parseInt(parts.find(q => q.type === 'minute').value, 10);
    h = hh + mm / 60;
  } catch (e) {
    const d = new Date();
    h = ((d.getUTCHours() + 5) % 24) + d.getUTCMinutes() / 60;
  }
  if (h >= 5 && h < 11) return 'morning';   // ertalab: yorug', quyosh, qushlar
  if (h >= 11 && h < 17) return 'day';      // kunduz
  if (h >= 17 && h < 20) return 'sunset';   // kun botishi: qizil osmon, bulutlar
  return 'night';                           // kechasi: qora osmon, oy, yulduzlar
}

